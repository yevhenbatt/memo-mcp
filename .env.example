# Required: private self-hosted Mem0 REST API and a distinct MCP bearer token.
MEM0_API_URL=http://mem0-api:8000
MEM0_API_KEY=replace-with-private-mem0-api-key
MCP_BEARER_TOKEN=replace-with-a-long-random-client-token

# Scope must be derived by your trusted application for multi-user deployments.
MEMORY_SCOPE=replace-with-approved-memory-scope

# Set these to your public MCP endpoint. Do not use a production value in this file.
PUBLIC_MCP_URL=https://mcp.example.com/mcp
MCP_ALLOWED_HOSTS=mcp.example.com,mcp.example.com:443
MCP_ALLOWED_ORIGINS=https://mcp.example.com
MEMORY_RESOURCE_NAME=Self-hosted shared memory

# Optional OAuth 2.1/OIDC. Configure all values together.
OAUTH_ISSUER_URL=https://auth.example.com/realms/example
OAUTH_INTROSPECTION_URL=http://oauth-server:8080/realms/example/protocol/openid-connect/token/introspect
OAUTH_RESOURCE_CLIENT_ID=memo-mcp-resource-server
OAUTH_RESOURCE_CLIENT_SECRET=replace-with-private-resource-server-secret
OAUTH_ALLOWED_SUB=replace-with-approved-immutable-oidc-subject
OAUTH_REQUIRED_SCOPE=mem0.read
OAUTH_WRITE_SCOPE=mem0.write
